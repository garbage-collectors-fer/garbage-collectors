# Primjer konfiguracije za EcoSentry.
# Kopirajte ovu datoteku u .env i upišite vlastite vrijednosti.
# .env se ne commita (naveden je u .gitignore); ovdje nikad ne upisujte stvarne ključeve.
# Nazivi varijabli mogu se promijeniti kad tim odabere tehnologije.

# Google OpenID Connect / OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps
GOOGLE_MAPS_API_KEY=

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=

# Baza podataka
DATABASE_URL=
