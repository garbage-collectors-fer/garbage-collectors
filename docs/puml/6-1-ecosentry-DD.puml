' ==============================================================================
' 6-1-ecosentry-DD.puml
'
' Svrha:    Prikazuje razmještaj sustava EcoSentry: jednu Docker web-uslugu na
'           platformi Render u kojoj Spring Boot poslužuje i REST API i izgrađeni
'           React klijent, PostgreSQL bazu na usluzi Neon te vanjske usluge s
'           kojima preglednik i poslužitelj komuniciraju.
' Autor:    [upisati ime autora]
' AI:       Claude je pomogao pri izradi nacrta dijagrama prema Dockerfileu i
'           konfiguraciji u repozitoriju; autor mora provjeriti da dijagram
'           odgovara stvarnom postavljanju.
' Praćenje: Pri promjeni produkcijske topologije (npr. nova baza, pohrana slika
'           na vanjskoj usluzi) ažurirati model i dokument 6.
'
' Diagram level: Physical Deployment Architecture
' Diagram type:  Deployment Diagram
' Version:       1.1
' ==============================================================================

@startuml
title Sustav EcoSentry – razmještaj

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #212529
}

skinparam cloud {
    BackgroundColor #F8F9FA
    BorderColor #212529
}

skinparam artifact {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

skinparam database {
    BackgroundColor #FFF3CD
    BorderColor #212529
}

skinparam note {
    BackgroundColor #F8F9FA
    BorderColor #212529
    FontColor #212529
}

' ==============================================================================
' Čvorovi, okruženja i razmješteni artefakti
' ==============================================================================
node "Korisnički uređaj" as Device <<device>> {
  node "Web-preglednik" as Browser <<executionEnvironment>>
}

cloud "Platforma Render" as Render {

  node "Web-usluga (Docker slika iz Dockerfilea)" as Service <<executionEnvironment>> {
    node "Java 21 (JRE)" as Jre <<executionEnvironment>> {
      artifact "Spring Boot aplikacija\n(app.jar: REST API + Google prijava)" as Backend <<artifact>>
      artifact "Izgrađeni React klijent\n(statičke datoteke u app.jar)" as Frontend <<artifact>>
    }
    artifact "Mapa uploads/\n(slike prijava, privremeni disk)" as Uploads <<artifact>>
  }

  note right of Service
    Usluga sluša na 0.0.0.0 i portu iz
    varijable PORT (dodjeljuje Render).
    Varijable okruženja: GOOGLE_CLIENT_ID,
    GOOGLE_CLIENT_SECRET, FRONTEND_URL,
    DB_HOST, DB_USER, DB_PASSWORD.
  end note
}

cloud "Neon" as NeonCloud {
  database "PostgreSQL (neondb)" as DB <<database>>
}

cloud "Vanjske usluge" as External {
  node "Google prijava (OAuth 2.0 / OpenID Connect)" as IdP <<server>>
  node "Google Maps JavaScript API" as Maps <<server>>
}

' ==============================================================================
' Komunikacijski putovi
' ==============================================================================

' 1. Isporuka klijenta, REST API i slike prijava (isti izvor, ista usluga)
Browser -[#blue]-> Service : <<HTTPS : 443>> \n statičke datoteke, REST / JSON, slike

' 2. Veza poslužitelja s bazom
Service -[#green,bold]-> DB : <<TCP/IP : 5432, TLS>> \n JDBC, migracije (Flyway)

' 3. Prijava preko Googlea
Browser -[#darkorange]-> IdP : <<HTTPS : 443>> \n preusmjeravanje na Google prijavu
Service -[#darkorange]-> IdP : <<HTTPS : 443>> \n razmjena koda za token i podaci o korisniku

' 4. Karta (poziva se izravno iz preglednika)
Browser -[#darkorange]-> Maps : <<HTTPS : 443>> \n učitavanje karte (ključ u klijentu)
@enduml
