# Kopirajte ovu datoteku u backend/.env i upisite vrijednosti.
# backend/.env se ne commita. Kljuceve za Google prijavu dobijete od Nikole.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neobavezno. Kamo backend vraca korisnika nakon prijave (zadano http://localhost:5173).
# FRONTEND_URL=http://localhost:5173

# Baza (Neon, grana production, host BEZ -pooler, kada otvarate vezu Neonu priko COnnect,
#po zadanom je ponudena adresa sa poolingom, manje bitno u biti, naznacujem radi transparentnosti,
#nekad to flywayu moze stvoriti problem kod buducih migracija). Vrijednosti trazite od nadleznog za rad s bazom(pave).
